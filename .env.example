# generate a random secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=****

# Local Postgres (WSL Docker on host port 5433, or Neon).
# Windows: prefer WSL IP, not 127.0.0.1:5432 (stale wslrelay).
# POSTGRES_URL=postgres://cited:password@<WSL-IP>:5433/cited_rag
POSTGRES_URL=****

# DeepSeek OpenAI-compatible chat (not Vercel AI Gateway).
DEEPSEEK_API_KEY=****
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Python knowledge service
PYTHON_RAG_URL=http://127.0.0.1:8000

# Unused in phase 1. Missing token: chat image upload fails.
# Knowledge ingest uses the Python service, not Vercel Blob.
BLOB_READ_WRITE_TOKEN=****

# Unused in phase 1. Missing URL: no production IP rate limit, no resumable stream replay.
REDIS_URL=****
