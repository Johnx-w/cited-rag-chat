# Chat LLM (DeepSeek OpenAI-compatible). Used later by eval; ingest/retrieve need embeddings.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embeddings are a separate OpenAI-compatible gateway (DeepSeek has no embedding API).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=indexes/chroma

