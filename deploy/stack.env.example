# 栈级变量：只给 docker-compose.prod.yml 用，通过 --env-file deploy/stack.env 读入。
# 容器内的应用变量在 deploy/web.env 与 deploy/python.env，不是这份。

# 对外域名。必须已经解析到本机公网 IP，否则 Caddy 申请不到证书。
SITE_DOMAIN=rag.example.com

# Postgres 凭据。改完记得同步改 deploy/web.env 里的 POSTGRES_URL。
POSTGRES_USER=cited
POSTGRES_PASSWORD=请换成一串长随机值
POSTGRES_DB=cited_rag
