# 知识库服务变量（compose 的 env_file 注入，等价于本地的 python/.env）
# 复制成 deploy/python.env 再填。该文件已被 .gitignore。

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# DeepSeek 没有 embedding 接口，这里要填一个 OpenAI 兼容的向量网关
# （智谱 / 硅基流动 / 阿里百炼都行）。
# 留空则自动 fail-open 到镜像里已预热好的本地 MiniLM，效果够演示用，但
# 入库与检索都要跑 CPU，语料变大后会变慢。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

CHROMA_PATH=indexes/chroma

# 只有当本服务对公网开放时才需要设，值要与 deploy/web.env 的 INTERNAL_TOKEN 一致。
# 用 docker-compose.prod.yml 时不需要。
INTERNAL_TOKEN=

# 无持久盘的环境（Render free / Hugging Face Spaces）设为 1：
# 容器启动时如果索引为空，就用 data/sample 重新播种，冷启动后依然有语料可问。
BOOTSTRAP_INGEST=0
