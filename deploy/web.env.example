# Next.js 应用变量（compose 的 env_file 注入，等价于本地的 .env.local）
# 复制成 deploy/web.env 再填。该文件已被 .gitignore。

# 会话密钥。生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# 指向同一个 Compose 网络里的 postgres 服务。用户密码要和 stack.env 一致。
POSTGRES_URL=postgres://cited:请换成与stack.env相同的密码@postgres:5432/cited_rag

# 聊天模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 知识库服务。同一网络内直连服务名，不走公网。
PYTHON_RAG_URL=http://python:8000

# 本方案里 python 未对公网开放，无需密钥。真要暴露再与 python.env 设成同一个值。
INTERNAL_TOKEN=

# 选填：Upstash Redis（免费档即可）。不设就没有 IP 限流与断线续传。
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# 选填：Vercel Blob。不设则聊天里的图片附件不可用（知识库上传不受影响）。
# BLOB_READ_WRITE_TOKEN=
